# App
APP_ENV=local
APP_NAME=kalisia-backend
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=*

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kalisia
POSTGRES_SSL=

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 Object Storage (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_TTL_SECONDS=3600

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# UI/Branding
COMPANY_LOGO_URL=

# JWT
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Rate limits
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5
